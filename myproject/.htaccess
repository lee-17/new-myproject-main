<IfModule mod_rewrite.c>
    RewriteEngine On

    # Keep uploaded/public storage files reachable without a symlink.
    RewriteRule ^storage/(.*)$ public/storage/$1 [L]

    # Serve Vite assets from Laravel's public directory.
    RewriteRule ^build/(.*)$ public/build/$1 [L]
    RewriteRule ^(favicon\.ico)$ public/$1 [L]

    # Send application routes to Laravel's front controller.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ public/index.php [L]
</IfModule>
