APP_NAME=MemberHub
APP_ENV=production
APP_KEY=copy_the_existing_local_app_key_here
APP_DEBUG=false
APP_URL=https://your-infinityfree-domain

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=copy_from_infinityfree_mysql_databases
DB_PORT=3306
DB_DATABASE=copy_from_infinityfree_mysql_database
DB_USERNAME=copy_from_infinityfree_mysql_username
DB_PASSWORD=copy_from_infinityfree_mysql_password

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

GOOGLE_MAPS_KEY=replace_with_browser_restricted_google_key
OPENWEATHER_KEY=replace_with_openweather_server_key

VITE_APP_NAME="${APP_NAME}"
